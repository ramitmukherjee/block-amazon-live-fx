{
  "manifest_version": 3,
  "name": "block-amazon-live-fx-in",
  "version": "1.0",

  "description": "A lightweight extension that blocks the pesky amazon live videos that start playing in Amazon India websites.",

  "icons": {
    "48": "icons/border-48.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "ramit.mkj6@gmail.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.amazon.in/*"],
      "js": ["block-amazon-live-fx.js"]
    }
  ]
}